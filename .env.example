# Chave da API do defapi.org (nunca commitar o .env real)
JEV_API_KEY=

# Endpoint de chat completions do jev. CONFIRMAR na documentação do defapi.org.
JEV_API_URL=https://api.defapi.org/v1/chat/completions

# Versão do modelo
JEV_MODEL=jev-1.13

# Tempo máximo de espera pela resposta do jev (ms)
JEV_TIMEOUT_MS=30000

# Incerteza padrão do modelo de referência quando há um único valor por vendedor (0.10 = 10%)
BASELINE_CV=0.10

PORT=3000
HOST=0.0.0.0
